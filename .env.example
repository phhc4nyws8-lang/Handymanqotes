# --- Database ---
# Dev/demo default: local SQLite file, zero setup required.
# Production: point this at Postgres instead (Neon/Supabase/RDS) and change
# the `provider` in prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Secret used to sign admin session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- Demo mode ---
# When "true" (default), AI photo generation and outbound email are mocked
# out — no API keys needed, no charges, nothing sent to real customers.
# Set to "false" once you've added real GEMINI_API_KEY / RESEND_API_KEY below.
DEMO_MODE="true"

# --- AI "after" photo generation (Google Gemini image editing) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# --- Email (Resend) ---
# Get a key at https://resend.com/api-keys — you'll also need to verify a
# sending domain there before real customer emails will deliver.
RESEND_API_KEY=""
EMAIL_FROM="Quotes <quotes@yourdomain.com>"

# --- App URL ---
# Used to build absolute photo links inside quote emails (email clients
# can't load relative /uploads/... paths). Set to your real deployed URL
# once you're out of demo mode.
APP_URL="http://localhost:3000"

# --- Seed admin login (optional) ---
# Overrides the default admin@example.com / changeme123 created by
# `npm run db:seed`. Change this before using the app for real.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
