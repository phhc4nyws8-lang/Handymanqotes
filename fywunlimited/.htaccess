# Namecheap shared hosting (LiteSpeed/Apache)

RewriteEngine On

# Force HTTPS and the bare domain (www.fywunlimited.com -> fywunlimited.com).
# Only works once SSL is active on the domain (cPanel > SSL/TLS Status).
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://fywunlimited.com%{REQUEST_URI} [L,R=301]

# Don't expose the README or other docs.
<FilesMatch "\.(md|txt)$">
  Require all denied
</FilesMatch>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Caching: HTML always revalidates; assets cached for a week.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

Options -Indexes
